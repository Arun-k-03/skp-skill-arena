# SKP Cultural Fest 2026 - Skill Arena Environment Configuration

# Application
NODE_ENV=development
PORT=3001

# Authoritative Database (PostgreSQL / Neon Serverless - Required in Production)
DATABASE_URL=

# Realtime / Rate Limiting (Upstash Redis REST - Optional)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Session and CSRF Security (Minimum 32 random characters in Production)
SESSION_SECRET=
CSRF_SECRET=

# CORS Origin
CORS_ORIGIN=http://localhost:3000

# Platform Administrator Credentials (Required in Production)
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Firebase Client Configuration (Google Authentication Only)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
